# ---------------------------------------------------------------- system / editors
.DS_Store
**/.DS_Store
.idea/
.vscode/
*.iml
__pycache__/
*.pyc

# ---------------------------------------------------------------- LaTeX build files
latex/*.aux
latex/*.bbl
latex/*.bcf
latex/*.blg
latex/*.fdb_latexmk
latex/*.fls
latex/*.log
latex/*.out
latex/*.run.xml
latex/*.synctex.gz
latex/*.toc
latex/*.lof
latex/*.lot
latex/*.loa
latex/*.lol
latex/*.glo
latex/*.gls
latex/*.glg
latex/*.ist
latex/*.xdv
# the built PDF is kept out too (it is rebuilt from the .tex files); remove this line to commit it
latex/thesis.pdf

# ---------------------------------------------------------------- benchmark: build output, downloaded tools
legacy-test-benchmark/**/target/
legacy-test-benchmark/tools/

# generated test suites (thousands of files, regenerated by the scripts)
# kept: hand-written reference tests (src/test/java) and the golden master suite
legacy-test-benchmark/*/suites/*
!legacy-test-benchmark/*/suites/golden-master/
legacy-test-benchmark/*/suites/golden-master/generation_meta.txt

# results: keep the summary tables and the report, not the raw copies of every run
legacy-test-benchmark/results*/raw/
legacy-test-benchmark/results*/*.log
legacy-test-benchmark/results-quick/

# case study on the real project: may contain company code / class names -> never commit
legacy-test-benchmark/casestudy.conf
legacy-test-benchmark/casestudy-work/
legacy-test-benchmark/results-casestudy/
