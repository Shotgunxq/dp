<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>sk.thesis</groupId>
    <artifactId>legacy-test-benchmark</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>benchmark-core</module>
        <module>benchmark-modern</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Tests are compiled for Java 17 so they run on JDK 17/21/25. -->
        <maven.compiler.testRelease>17</maven.compiler.testRelease>

        <!-- Versions: check Maven Central and bump if needed. Minimums for JDK 25:
             JaCoCo 0.8.14, PIT 1.25.8, Mockito 5.22. -->
        <junit.version>5.13.4</junit.version>
        <junit4.version>4.13.2</junit4.version>
        <mockito.version>5.22.0</mockito.version>
        <approvaltests.version>31.0.0</approvaltests.version>
        <jacoco.version>0.8.14</jacoco.version>
        <pitest.version>1.25.8</pitest.version>
        <pitest.junit5.version>1.2.3</pitest.junit5.version>
        <!-- PIT worker threads; run_iteration.py sets this to the number of CPU cores -->
        <pit.threads>4</pit.threads>
        <!-- golden master (B1): approve mode is only switched on by scripts/approve_golden_master.sh -->
        <golden.approve>false</golden.approve>
        <golden.dir></golden.dir>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- JUnit 5: reference suite and LLM-generated tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JUnit 4 + vintage engine: Randoop and EvoSuite generate JUnit 4 tests -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit4.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Mockito: for LLM-generated tests that use mocks -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- ApprovalTests: golden master baseline (B1) -->
        <dependency>
            <groupId>com.approvaltests</groupId>
            <artifactId>approvaltests</artifactId>
            <version>${approvaltests.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- golden-master *.approved.txt files live next to the tests in the suite folder;
             copying them to the test classpath makes them available in Surefire and in PIT -->
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>${suite.dir}</directory>
                <includes>
                    <include>**/*.approved.txt</include>
                </includes>
            </testResource>
        </testResources>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.3</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <golden.approve>${golden.approve}</golden.approve>
                        <golden.dir>${golden.dir}</golden.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Line and branch coverage: target/site/jacoco/jacoco.csv (per class) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Mutation testing: mvn test-compile org.pitest:pitest-maven:mutationCoverage
                 Results: target/pit-reports/mutations.csv -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest.junit5.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>benchmark.*</param>
                    </targetClasses>
                    <excludedClasses>
                        <param>benchmark.support.*</param>
                    </excludedClasses>
                    <outputFormats>
                        <param>HTML</param>
                        <param>CSV</param>
                        <param>XML</param>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <threads>${pit.threads}</threads>
                    <!-- generated suites often contain failing tests; PIT ignores them -->
                    <skipFailingTests>true</skipFailingTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
